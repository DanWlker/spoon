{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spoon Configuration Schema",
  "description": "Schema for the Spoon application's configuration file.",
  "type": "object",
  "properties": {
    "core": {
      "type": "object",
      "description": "Core application settings",
      "properties": {
        "option": {
          "type": "object",
          "description": "General core settings",
          "properties": {
            "protocol": {
              "type": "string",
              "description": "The protocol type for rendering images of commit graphs. The value specified in the command line argument takes precedence.",
              "enum": [
                "auto",
                "iterm",
                "kitty",
                "kitty-unicode"
              ],
              "default": "auto"
            },
            "order": {
              "type": "string",
              "description": "The commit ordering algorithm. The value specified in the command line argument takes precedence.",
              "enum": [
                "chrono",
                "topo"
              ],
              "default": "chrono"
            },
            "graph_width": {
              "type": "string",
              "description": "The character width that a graph image unit cell occupies. The value specified in the command line argument takes precedence.",
              "enum": [
                "auto",
                "double",
                "single"
              ],
              "default": "auto"
            },
            "graph_style": {
              "type": "string",
              "description": "The commit graph image edge style. The value specified in the command line argument takes precedence.",
              "enum": [
                "rounded",
                "angular",
                "curved"
              ],
              "default": "rounded"
            },
            "graph_antialias": {
              "type": "boolean",
              "description": "Whether to antialias commit graph images. The value specified in the command line argument takes precedence.",
              "default": false
            },
            "initial_selection": {
              "type": "string",
              "description": "The initial selection of commit when starting the application. The value specified in the command line argument takes precedence.",
              "enum": [
                "latest",
                "head"
              ],
              "default": "latest"
            }
          },
          "additionalProperties": false
        },
        "git": {
          "type": "object",
          "description": "Git integration settings",
          "properties": {
            "mailmap": {
              "type": "boolean",
              "description": "Whether to resolve author and committer identities through the repository's .mailmap file.",
              "default": false
            },
            "merge_tool": {
              "type": "string",
              "description": "The merge tool to resolve conflicts with, passed to `git mergetool --tool`. Git's merge.tool config is used when not set."
            }
          },
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "description": "Default search settings",
          "properties": {
            "target": {
              "type": "string",
              "description": "The field to search by default.",
              "enum": [
                "all",
                "subject",
                "author",
                "ref",
                "hash"
              ],
              "default": "all"
            },
            "smart_case": {
              "type": "boolean",
              "description": "Whether to search with smart case by default: ignoring case unless the query has an uppercase letter. Off searches case-sensitively.",
              "default": true
            },
            "fuzzy": {
              "type": "boolean",
              "description": "Whether to enable fuzzy matching by default, in the commit list and in the search and filter of the file trees.",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "user_command": {
          "type": "object",
          "description": "Custom user command definitions.",
          "properties": {
            "tab_width": {
              "type": "integer",
              "description": "The number of spaces to replace tabs in the user command output.",
              "default": 4
            }
          },
          "patternProperties": {
            "^commands_[0-9]+$": {
              "type": "object",
              "description": "A custom command. The key must be in the format 'commands_{n}' where n is a number.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the command to be displayed."
                },
                "type": {
                  "type": "string",
                  "description": "The type of user command.",
                  "enum": [
                    "inline",
                    "silent",
                    "suspend"
                  ],
                  "default": "inline"
                },
                "commands": {
                  "type": "array",
                  "description": "The command and its arguments to execute.",
                  "items": {
                    "type": "string"
                  }
                },
                "refresh": {
                  "type": "boolean",
                  "description": "Whether to reload the repository and refresh the display after executing the command. Available for 'silent' and 'suspend' commands.",
                  "default": false
                }
              },
              "required": [
                "name",
                "commands"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "browser": {
          "type": "object",
          "description": "Opening the pages of commits, branches, tags and files on the web host of a remote (o), or copying their links (O).",
          "properties": {
            "services": {
              "type": "object",
              "description": "The kind of host of a domain its name doesn't tell: \"github\", \"gitlab\", \"bitbucket\" or \"gitea\"; \"kind:domain\" for an ssh alias whose pages are on another domain; or link patterns of its own.",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Link patterns: {base} is https://host/owner/repo; {hash}, {branch}, {tag} and {path} what is linked to.",
                    "properties": {
                      "commit": { "type": "string" },
                      "branch": { "type": "string" },
                      "pull_request": { "type": "string" },
                      "tag": { "type": "string" },
                      "file": { "type": "string" },
                      "line": { "type": "string", "description": "Added to the file's link for a selected line: {start}." },
                      "lines": { "type": "string", "description": "Added to the file's link for selected lines: {start} to {end}." }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "external": {
          "type": "object",
          "description": "Configuration for external commands used by the application.",
          "properties": {
            "clipboard": {
              "description": "The clipboard command to use for copy operations.\n- \"auto\": Use the default clipboard library\n- { custom = { commands = [\"...\"] } }: Use a custom command that receives text via stdin",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "custom": {
                      "type": "object",
                      "properties": {
                        "commands": {
                          "type": "array",
                          "description": "A custom command that receives text via stdin.",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "commands"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "custom"
                  ],
                  "additionalProperties": false
                }
              ],
              "default": "auto"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "description": "UI appearance settings",
      "properties": {
        "common": {
          "type": "object",
          "properties": {
            "cursor_type": {
              "description": "The type of cursor to display in input fields.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "native"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "virtual": {
                      "type": "string",
                      "description": "A string to be used as a virtual cursor."
                    }
                  },
                  "required": [
                    "virtual"
                  ],
                  "additionalProperties": false
                }
              ],
              "default": "native"
            }
          },
          "additionalProperties": false
        },
        "list": {
          "type": "object",
          "description": "Settings for the commit list view.",
          "properties": {
            "scrolloff": {
              "type": "integer",
              "description": "Minimum number of visible rows to keep above and below the selected commit where possible.",
              "minimum": 0,
              "maximum": 65535,
              "default": 0
            },
            "columns": {
              "type": "array",
              "description": "The order and visibility of columns in the commit list.",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/userListColumnType"
              },
              "default": [
                "graph",
                "marker",
                "subject",
                "name",
                "hash",
                "date"
              ]
            },
            "subject_min_width": {
              "type": "integer",
              "description": "The minimum width of a subject in the commit list.",
              "minimum": 1,
              "maximum": 65535,
              "default": 20
            },
            "date_format": {
              "type": "string",
              "description": "The date format for the author date in strftime format.",
              "minLength": 1,
              "default": "%Y-%m-%d"
            },
            "date_width": {
              "type": "integer",
              "description": "The width of the author date column.",
              "minimum": 0,
              "maximum": 65535,
              "default": 10
            },
            "date_local": {
              "type": "boolean",
              "description": "Whether to show the author date in local timezone.",
              "default": true
            },
            "name_width": {
              "type": "integer",
              "description": "The width of the author name column.",
              "minimum": 0,
              "maximum": 65535,
              "default": 20
            }
          },
          "additionalProperties": false
        },
        "detail": {
          "type": "object",
          "description": "Settings for the commit detail view.",
          "properties": {
            "height": {
              "type": "integer",
              "description": "The height of the commit detail area.",
              "minimum": 1,
              "maximum": 65535,
              "default": 20
            },
            "date_format": {
              "type": "string",
              "description": "The date format for author/committer dates in strftime format.",
              "minLength": 1,
              "default": "%Y-%m-%d %H:%M:%S %z"
            },
            "date_local": {
              "type": "boolean",
              "description": "Whether to show dates in local timezone.",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "user_command": {
          "type": "object",
          "description": "Settings for the user command view.",
          "properties": {
            "height": {
              "type": "integer",
              "description": "The height of the user command area.",
              "default": 20
            }
          },
          "additionalProperties": false
        },
        "refs": {
          "type": "object",
          "description": "Settings for the refs list view.",
          "properties": {
            "width": {
              "type": "integer",
              "description": "The width of the refs list area.",
              "minimum": 1,
              "maximum": 65535,
              "default": 26
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "description": "Commit graph rendering settings",
      "properties": {
        "row_image_width": {
          "type": "string",
          "description": "The width mode for each graph row image.",
          "enum": [
            "compact",
            "fixed"
          ],
          "default": "compact"
        },
        "color": {
          "type": "object",
          "description": "Colors for the commit graph.",
          "properties": {
            "branches": {
              "type": "array",
              "description": "Colors used for the branches in the graph. Should be in #RRGGBB or #RRGGBBAA format.",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
              },
              "default": [
                "#F38BA8",
                "#A6E3A1",
                "#F9E2AF",
                "#89B4FA",
                "#CBA6F7",
                "#94E2D5"
              ]
            },
            "edge": {
              "type": "string",
              "description": "Color of the edge surrounding the commit circles. Should be in #RRGGBB or #RRGGBBAA format.",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "default": "#00000000"
            },
            "background": {
              "type": "string",
              "description": "Background color of the commit graph. Should be in #RRGGBB or #RRGGBBAA format.",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
              "default": "#00000000"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "description": "The colors of each element of the application. Colors can be specified as ANSI color names (e.g., 'red', 'bright-blue'), 8-bit color indices (e.g., '34', '128'), or 24-bit hex codes (e.g., '#abcdef').",
      "properties": {
        "fg": {
          "type": "string",
          "description": "Foreground color.",
          "default": "#cdd6f4"
        },
        "bg": {
          "type": "string",
          "description": "Background color.",
          "default": "reset"
        },
        "list_selected_fg": {
          "type": "string",
          "description": "Foreground color for a selected item in lists.",
          "default": "#cdd6f4"
        },
        "list_selected_bg": {
          "type": "string",
          "description": "Background color for a selected item in lists.",
          "default": "#313244"
        },
        "list_picked_fg": {
          "type": "string",
          "description": "Foreground color for commits picked with space in the commit list.",
          "default": "#11111b"
        },
        "list_picked_bg": {
          "type": "string",
          "description": "Background color for commits picked with space in the commit list.",
          "default": "#cba6f7"
        },
        "list_ref_branch_fg": {
          "type": "string",
          "description": "Color for local branches in the commit list.",
          "default": "#a6e3a1"
        },
        "list_ref_head_fg": {
          "type": "string",
          "description": "Color for the checked-out branch in the commit list.",
          "default": "#89b4fa"
        },
        "list_ref_remote_branch_fg": {
          "type": "string",
          "description": "Color for remote branches in the commit list.",
          "default": "#a6e3a1"
        },
        "list_ref_tag_fg": {
          "type": "string",
          "description": "Color for tags in the commit list.",
          "default": "#f9e2af"
        },
        "list_ref_stash_fg": {
          "type": "string",
          "description": "Color for stashes in the commit list.",
          "default": "#cba6f7"
        },
        "list_subject_fg": {
          "type": "string",
          "description": "Color for the commit subject in the commit list.",
          "default": "#cdd6f4"
        },
        "list_name_fg": {
          "type": "string",
          "description": "Color for the author name in the commit list.",
          "default": "#cdd6f4"
        },
        "list_hash_fg": {
          "type": "string",
          "description": "Color for the commit hash in the commit list.",
          "default": "#cdd6f4"
        },
        "list_date_fg": {
          "type": "string",
          "description": "Color for the date in the commit list.",
          "default": "#cdd6f4"
        },
        "list_dimmed_fg": {
          "type": "string",
          "description": "Color for the subject, author name, hash and date of commits that are not on the current branch.",
          "default": "#6c7086"
        },
        "list_match_fg": {
          "type": "string",
          "description": "Foreground color for a search match in the commit list.",
          "default": "#11111b"
        },
        "list_match_bg": {
          "type": "string",
          "description": "Background color for a search match in the commit list.",
          "default": "#f9e2af"
        },
        "detail_label_fg": {
          "type": "string",
          "description": "Color for labels in the commit detail view.",
          "default": "#7f849c"
        },
        "detail_name_fg": {
          "type": "string",
          "description": "Color for author/committer names in the commit detail view.",
          "default": "#cdd6f4"
        },
        "detail_date_fg": {
          "type": "string",
          "description": "Color for author/committer dates in the commit detail view.",
          "default": "#cdd6f4"
        },
        "detail_email_fg": {
          "type": "string",
          "description": "Color for author/committer email addresses in the commit detail view.",
          "default": "#89b4fa"
        },
        "detail_hash_fg": {
          "type": "string",
          "description": "Color for the commit hash in the commit detail view.",
          "default": "#cdd6f4"
        },
        "detail_file_change_add_fg": {
          "type": "string",
          "description": "Color for added file status in the commit detail view.",
          "default": "#a6e3a1"
        },
        "detail_file_change_modify_fg": {
          "type": "string",
          "description": "Color for modified file status in the commit detail view.",
          "default": "#f9e2af"
        },
        "detail_file_change_delete_fg": {
          "type": "string",
          "description": "Color for deleted file status in the commit detail view.",
          "default": "#f38ba8"
        },
        "detail_file_change_move_fg": {
          "type": "string",
          "description": "Color for moved file status in the commit detail view.",
          "default": "#cba6f7"
        },
        "diff_add_bg": {
          "type": "string",
          "description": "Background color of the lines added in a diff.",
          "default": "#394545"
        },
        "diff_delete_bg": {
          "type": "string",
          "description": "Background color of the lines removed in a diff.",
          "default": "#493446"
        },
        "diff_add_word_bg": {
          "type": "string",
          "description": "Background color of the part of an added line that differs from the line it replaces.",
          "default": "#4e6356"
        },
        "diff_delete_word_bg": {
          "type": "string",
          "description": "Background color of the part of a removed line that differs from the line replacing it.",
          "default": "#694459"
        },
        "ref_selected_fg": {
          "type": "string",
          "description": "Foreground color for a selected item in the refs list.",
          "default": "#cdd6f4"
        },
        "ref_selected_bg": {
          "type": "string",
          "description": "Background color for a selected item in the refs list.",
          "default": "#313244"
        },
        "help_block_title_fg": {
          "type": "string",
          "description": "Color for block titles in the help view.",
          "default": "#cba6f7"
        },
        "help_key_fg": {
          "type": "string",
          "description": "Color for key bindings in the help view.",
          "default": "#89b4fa"
        },
        "virtual_cursor_fg": {
          "type": "string",
          "description": "Foreground color for the virtual cursor.",
          "default": "#cdd6f4"
        },
        "status_input_transient_fg": {
          "type": "string",
          "description": "Foreground color for transient messages in the status bar.",
          "default": "#7f849c"
        },
        "status_info_fg": {
          "type": "string",
          "description": "Color for informational messages in the status bar.",
          "default": "#89b4fa"
        },
        "status_success_fg": {
          "type": "string",
          "description": "Color for success messages in the status bar.",
          "default": "#a6e3a1"
        },
        "status_warn_fg": {
          "type": "string",
          "description": "Color for warning messages in the status bar.",
          "default": "#f9e2af"
        },
        "status_error_fg": {
          "type": "string",
          "description": "Color for error messages in the status bar.",
          "default": "#f38ba8"
        },
        "divider_fg": {
          "type": "string",
          "description": "Color for dividers.",
          "default": "#45475a"
        },
        "accent_fg": {
          "type": "string",
          "description": "Color of the focused panel's border, and of its title unless panel_title_focused_* say otherwise.",
          "default": "#89b4fa"
        },
        "accent_text_fg": {
          "type": "string",
          "description": "Color for text on the accent color, like the title badge of the focused panel.",
          "default": "#11111b"
        },
        "panel_title_focused_fg": {
          "type": "string",
          "description": "Text color of the focused panel's title.",
          "default": "#89b4fa"
        },
        "panel_title_focused_bg": {
          "type": "string",
          "description": "Background color of the focused panel's title, a badge; \"reset\" colors only the text, like lazygit.",
          "default": "#89b4fa"
        },
        "highlight_fg": {
          "type": "string",
          "description": "Color for the mark beside the selected row, and highlighted notes.",
          "default": "#cba6f7"
        },
        "status_bar_fg": {
          "type": "string",
          "description": "Foreground color of the status bar.",
          "default": "#a6adc8"
        },
        "status_bar_bg": {
          "type": "string",
          "description": "Background color of the status bar.",
          "default": "reset"
        }
      },
      "additionalProperties": false
    },
    "keybind": {
      "type": "object",
      "description": "Keybinding settings. Each property is an action, and its value is an array of key sequences, bound in the action's own scope; a table named after a scope binds actions in that scope only.",
      "properties": {
        "force_quit": {
          "$ref": "#/definitions/keybindArray"
        },
        "quit": {
          "$ref": "#/definitions/keybindArray"
        },
        "help_toggle": {
          "$ref": "#/definitions/keybindArray"
        },
        "cancel": {
          "$ref": "#/definitions/keybindArray"
        },
        "close": {
          "$ref": "#/definitions/keybindArray"
        },
        "navigate_up": {
          "$ref": "#/definitions/keybindArray"
        },
        "navigate_down": {
          "$ref": "#/definitions/keybindArray"
        },
        "navigate_right": {
          "$ref": "#/definitions/keybindArray"
        },
        "navigate_left": {
          "$ref": "#/definitions/keybindArray"
        },
        "select_up": {
