        },
        "page_up": {
          "$ref": "#/definitions/keybindArray"
        },
        "page_down": {
          "$ref": "#/definitions/keybindArray"
        },
        "half_page_up": {
          "$ref": "#/definitions/keybindArray"
        },
        "half_page_down": {
          "$ref": "#/definitions/keybindArray"
        },
        "go_to_next": {
          "$ref": "#/definitions/keybindArray"
        },
        "go_to_previous": {
          "$ref": "#/definitions/keybindArray"
        },
        "confirm": {
          "$ref": "#/definitions/keybindArray"
        },
        "ref_list": {
          "$ref": "#/definitions/keybindArray"
        },
        "search": {
          "$ref": "#/definitions/keybindArray"
        },
        "search_target_toggle": {
          "$ref": "#/definitions/keybindArray"
        },
        "smart_case_toggle": {
          "$ref": "#/definitions/keybindArray"
        },
        "fuzzy_toggle": {
          "$ref": "#/definitions/keybindArray"
        },
        "refresh": {
          "$ref": "#/definitions/keybindArray"
        },
        "resize_left": {
          "$ref": "#/definitions/keybindArray"
        },
        "resize_right": {
          "$ref": "#/definitions/keybindArray"
        },
        "resize_up": {
          "$ref": "#/definitions/keybindArray"
        },
        "resize_down": {
          "$ref": "#/definitions/keybindArray"
        },
        "focus_left": {
          "$ref": "#/definitions/keybindArray"
        },
        "focus_right": {
          "$ref": "#/definitions/keybindArray"
        },
        "focus_up": {
          "$ref": "#/definitions/keybindArray"
        },
        "focus_down": {
          "$ref": "#/definitions/keybindArray"
        },
        "keys_toggle": {
          "$ref": "#/definitions/keybindArray"
        },
        "short_copy": {
          "$ref": "#/definitions/keybindArray"
        },
        "full_copy": {
          "$ref": "#/definitions/keybindArray"
        },
        "ignore": {
          "$ref": "#/definitions/keybindArray"
        },
        "command_log": {
